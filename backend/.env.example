# SkillScan AI Backend Environment Variables

# MongoDB Atlas URI (Required for Render production deployment)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillscan?retryWrites=true&w=majority

# Gemini API Key (Optional fallback if user doesn't enter key in UI)
GEMINI_API_KEY=AIzaSy...

# Frontend Production URL on Vercel (For CORS security)
FRONTEND_URL=https://skillscan-ai.vercel.app

# Server Port (Auto-assigned by Render, defaults to 5000)
PORT=5000
